{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noImplicitAny": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types/next",
    "rootDir": "next/engine",
    "skipLibCheck": true,
    "lib": ["es2023", "dom"]
  },
  "include": ["next/engine/**/*.js"]
}
